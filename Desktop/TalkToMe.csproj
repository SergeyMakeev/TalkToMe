<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Icons/TalkToMe.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <EmbeddedResource Include="../Shared/EnglishPrompt.txt" LogicalName="TalkToMe.EnglishPrompt.txt" />
    <EmbeddedResource Include="../Shared/TranslateGemmaPrompt.txt" LogicalName="TalkToMe.TranslateGemmaPrompt.txt" />
    <EmbeddedResource Include="../Shared/LocalEditing.json" LogicalName="TalkToMe.LocalEditing.json" />
    <EmbeddedResource Include="../Shared/Models.json" LogicalName="TalkToMe.Models.json" />
    <EmbeddedResource Include="../Shared/WindowsRuntime.json" LogicalName="TalkToMe.WindowsRuntime.json" />
    <Content Include="../Shared/GemmaTerms.txt;../Shared/GemmaNotice.txt;../Shared/ModelNotices.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../build/diagnostics/Release/TalkToMe.CrashMonitor.exe" Link="TalkToMe.CrashMonitor.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../build/diagnostics/Release/TalkToMe.FocusHost.exe" Link="TalkToMe.FocusHost.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="Sounds/*.wav" />
    <EmbeddedResource Include="Icons/*.ico" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <InternalsVisibleTo Include="TalkToMe.Checks" />
  </ItemGroup>
  <Target Name="CheckDiagnostics" BeforeTargets="PrepareForPublish" Condition="'$(SelfContained)' == 'true'">
    <Error Condition="!Exists('../build/diagnostics/Release/TalkToMe.CrashMonitor.exe')"
           Text="Build Desktop/Diagnostics with CMake before publishing." />
    <Error Condition="!Exists('../build/diagnostics/Release/TalkToMe.FocusHost.exe')" Text="Build the native focus helper before publishing." />
  </Target>
</Project>

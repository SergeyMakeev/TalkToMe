<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Icons/TalkToMe.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <EmbeddedResource Include="../Shared/EnglishPrompt.txt" LogicalName="TalkToMe.EnglishPrompt.txt" />
    <EmbeddedResource Include="../Shared/Models.json" LogicalName="TalkToMe.Models.json" />
    <Content Include="../build/engines/**/*" Exclude="../build/engines/**/TalkToMeSpeech.dll" Link="engines/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="Sounds/*.wav" />
    <EmbeddedResource Include="Icons/*.ico" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <InternalsVisibleTo Include="TalkToMe.Checks" />
  </ItemGroup>
  <Target Name="CheckBundledEngines" BeforeTargets="PrepareForPublish" Condition="'$(SelfContained)' == 'true'">
    <Error Condition="!Exists('../build/engines/TalkToMeSpeechHost.exe') Or !Exists('../build/engines/llama-server.exe') Or !Exists('../build/engines/avx2/TalkToMeSpeechHost.exe') Or !Exists('../build/engines/avx2/llama-server.exe')"
           Text="Build the native CPU engines before publishing. Run py -3 Shared/build_engines.py build/engines --cuda from the repository root." />
    <Error Condition="!Exists('../build/engines/cuda/TalkToMeSpeechHost.exe') Or !Exists('../build/engines/cuda/llama-server.exe') Or !Exists('../build/engines/cuda/cudart64_13.dll') Or !Exists('../build/engines/cuda/cublas64_13.dll') Or !Exists('../build/engines/cuda/cublasLt64_13.dll') Or !Exists('../build/engines/cuda/CUDA-EULA.txt')"
           Text="The bundled NVIDIA engines are missing. Install CUDA Toolkit 13.0 for the build, then run py -3 Shared/build_engines.py build/engines --cuda." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Icons/TalkToMe.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <EmbeddedResource Include="../Shared/EnglishPrompt.txt" LogicalName="TalkToMe.EnglishPrompt.txt" />
    <EmbeddedResource Include="Sounds/*.wav" />
    <EmbeddedResource Include="Icons/*.ico" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <InternalsVisibleTo Include="TalkToMe.Checks" />
  </ItemGroup>
</Project>
